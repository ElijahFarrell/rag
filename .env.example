# Copy to .env and fill in locally. Do not commit .env.

# Hybrid server (hybrid_main.py) and knowledge-base API (main.py).
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Region used when main.py creates a Pinecone index. Default in code: us-east-1
PINECONE_ENVIRONMENT=us-east-1

# Optional. When empty, parsing falls back to local file readers.
LLAMA_CLOUD_API_KEY=

# Bearer token required by the upload and query routes. The server returns
# 503 for those routes when this is unset.
RAG_API_KEY=

# Comma-separated browser origins. Do not use *. Leave empty to send no
# Access-Control-Allow-Origin header.
# Example: http://localhost:3000,https://portfolio.example
CORS_ALLOWED_ORIGINS=

# Max upload size in bytes. Default in code: 20971520 (20 MiB)
MAX_UPLOAD_BYTES=20971520
